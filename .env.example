# "vllm" (self-hosted, default), "ollama" (local laptop, dev only) or "openrouter" (dev only; no network is allowed in the competition)
DATAMATE_BACKEND=vllm

# --- self-hosted vLLM (scripts/serve_vllm.sh) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3.5-9B

# --- local Ollama (scripts/ollama_run.sh sets these itself; the model comes from scripts/ollama/Modelfile) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5-datamate

# --- OpenRouter (temporary) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-9b
# Optional provider order (fallbacks allowed). Empty = OpenRouter default routing (fast).
# Darkbloom = cheapest + only host billing cache reads, but ~5-8x slower and fp4 weights.
OPENROUTER_PROVIDERS=

DATAMATE_TEMPERATURE=0.0
DATAMATE_THINKING=0
DATAMATE_WORKERS=4
DATAMATE_MAX_TURNS=3            # evaluated turns before abstaining (agent loop)
DATAMATE_CODER_STEPS=6          # Coder <-> Runner code blocks per turn
DATAMATE_EXPLAINER_RERUNS=1     # times the orchestrator may send the question back to the Explainer
DATAMATE_GATE=1                 # 1 = the Evaluator's checks in code send doubtful values back (empty, type, 0, walk-in...)
DATAMATE_EXPLAINER_CALLS=5      # Explainer agent: model calls in its loop ...
DATAMATE_EXPLAINER_CHECKS=2     # ... and clarity checks among them
DATAMATE_PLAN_THINKING=1        # thinking for the plan call only (coder never)
DATAMATE_PURCHASE_ENGINE=1      # purchase_total / purchase_avg_price / top_supplier for shops with purchase slips (engines/purchases.py)
DATAMATE_SHARED_PREFIX=0        # 1 = the shop context opens every model call (agents/shared.py); off: it made the Coder worse (ledger #9)
DATAMATE_GUIDELINE_ROWS=4       # rulebook rows of the question repeated before the Coder's OUTPUT (agents/guideline.py); 0 = off
DATAMATE_VERIFIED_FACTS=1       # counts from the data for the question's periods shown to the Coder (agents/facts.py)
DATAMATE_DECIDE=rule            # after a rejected turn: rule table on the verdicts (no model call) | model (old way, ledger #12)
DATAMATE_SKIP_JUDGE_ON_ENGINE=0 # 1 = no judge call when the answer equals an exact engine function's value (dev300: -1 question)
DATAMATE_TRUST_REPEAT=1         # a value the judge rejected and the Coder returned unchanged is accepted
DATAMATE_JUDGE_UNANSWERABLE=0   # 1 = the judge also reviews an UNANSWERABLE the code concluded (dev300: it hurt, ledger #12)
DATAMATE_JUDGE_FACTS=1          # the judge reads the VERIFIED FACTS and the engine value, and may quote them as evidence
DATAMATE_JUDGE_EVIDENCE=fragments  # a revise also stands when a piece of its evidence is verbatim in the FACTS / ENGINE VALUE; strict = as before
DATAMATE_JUDGE_FORMAT=v2       # v2: evidence before problem/fix, a cut reply read up to the cut; v1: as before
DATAMATE_JUDGE_MAX_TOKENS=1500  # judge output cap (800 cut 8/287 dev300 replies: read as unreadable = accept)
DATAMATE_JUDGE_PERIODS=0        # 1 = the judge also reads the periods code computed (named in the question, in the spec, still open)
DATAMATE_AUDIT=shadow           # code audits (answer/audit.py): off | shadow (logged only) | on (an issue, said once)
DATAMATE_ENFORCE_HINTS=item_qty  # engine hints the Coder is sent back on once when it differs (empty = log only)
DATAMATE_AUDIT_SKIP=date_literal  # with AUDIT=on, these audits stay log-only: entity_absent,profit_bound,period_mismatch,date_literal
DATAMATE_LEXICON=1              # shop owners' spellings in one standard form before the code reads the question (datamate/lexicon.py)
DATAMATE_GLOSSARY=1             # glossed lexicon words (o đờ, đh, ck, tm) explained in the spec prompt
DATAMATE_STRUCTURE_CARDS=1      # schema cards state parent/child tables, document totals, README notes (data/structure.py); 0 = old cards
DATAMATE_THINKING_MAX_TOKENS=12288
DATAMATE_MEM_LIMIT_GB=16           # address-space cap of the harness process (Linux); a runaway merge raises MemoryError instead of an OOM kill. 0 = off
DATAMATE_QUESTION_DEADLINE_S=900   # one question may take this long (0 = no limit); then it submits the latest value that passed the checks in code, else abstains
DATAMATE_RUN_DEADLINE_S=0          # the whole run's limit in seconds (0 = none); the competition's is 6 h: set it below that (e.g. 20000)
DATAMATE_RUN_QUICK_S=1800          # with this much of the run left, a question gets one turn and no Explainer re-run
DATAMATE_DEADLINE_FALLBACK=checked # what a question out of time submits: checked | abstain
